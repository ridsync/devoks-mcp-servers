# devoks-mcp-servers — Management MCP 서버 환경변수 예시 (Stage 1)
#
# 사용법: 이 파일을 `.env`로 복사한 뒤 값을 채워라. `.env`는 `.gitignore`에 의해
# 커밋 대상에서 제외된다(실제로 추적되는지는 README의 "환경변수" 절 참고).
#
#   cp .env.example .env
#   uv run --env-file .env uvicorn devoks_mcp_management.app:create_app_from_env \
#     --factory --host 127.0.0.1 --port 8000 --app-dir servers/management/src
#
# ⚠️ JSON 값(MCP_CLIENT_TOKENS, MCP_ROLE_TOOLS)과 GITHUB_APP_PRIVATE_KEY는 반드시
# 아래처럼 값 전체를 작은따옴표(')로 감싸라. 감싸지 않으면 `uv run --env-file`도
# `bash -c 'set -a; source .env; set +a'`도 내부 큰따옴표를 shell 인용부호로 오인해
# 잘라먹는다(둘 다 실측 확인됨) — JSON이 깨진 채로 `MCP_CLIENT_TOKENS is not valid
# JSON` 기동 실패를 30분간 디버깅하게 되는 지점이다.
#
# 각 키의 계약 근거: FRD.md §5.2(CTR-006) — 이 저장소를 클론했다면
# .claude/workspace/management-mcp-bootstrap-20260903/FRD.md 에서 원문을 볼 수 있다.
#
# 필수 8개 키 중 하나라도 없으면 서버는 기동에 실패한다(Fail-Fast, config.py) —
# 조용히 떠서 요청을 421/401로 거절하는 상태를 막기 위한 의도된 설계다.

# ============================================================================
# 필수 — 없으면 기동 실패 (config.py의 _REQUIRED_KEYS 8개)
# ============================================================================

# transport_security가 허용하는 Host 목록(콤마 구분). 이 값이 비어 있으면 기동
# 자체가 실패한다 — 없이 뜨면 실제 호스트명 뒤에서 전 요청이 421이 되고, 클라이언트
# 에는 일반 전송 오류로만 보여 원인 추적이 매우 어렵기 때문이다.
# app.py의 _expand_allowed_hosts가 포트 없는 항목을 "host"와 "host:*" 두 형태로
# 자동 확장하므로, 로컬 개발에서 포트 변형(127.0.0.1:8000 등)까지 직접 나열할
# 필요는 없다 — 아래 두 값만으로 uvicorn --port 8000이든 다른 포트든 그대로 붙는다.
MCP_ALLOWED_HOSTS='127.0.0.1,localhost'

# 이 서버의 공개 URL. RFC 9728 Protected Resource Metadata 문서의 `resource` 값이자
# well-known 경로(/.well-known/oauth-protected-resource/mcp)가 파생되는 원본이다.
# ⚠️ 경로가 반드시 `/mcp`로 끝나야 하고 후행 슬래시가 있으면 안 된다. 틀려도 서버는
# "정상 기동"하지만(!) well-known 경로가 조용히 다른 곳으로 어긋난다 — 이 프로젝트는
# 그 흔한 실수를 기동 시점에 잡아 에러 메시지로 알려주도록 만들어 뒀다
# (config.py의 _parse_public_url). 로컬 개발은 http, 배포는 https를 쓴다.
MCP_PUBLIC_URL='http://127.0.0.1:8000/mcp'

# OAuth issuer URL(AuthSettings.issuer_url). Stage 1은 정적 토큰 검증이라 실제
# OAuth 인가서버가 없어도 되지만, 값 자체는 유효한 http(s) URL 형식이어야 한다.
MCP_ISSUER_URL='http://127.0.0.1:8000'

# CTR-002 클라이언트 토큰 테이블. JSON: {token: {client_id, role, scopes[]}}.
# 아래 예시 값은 실제로 load_settings()를 통과함이 검증됐고(TASK-032), CI의 컨테이너
# 기동 스모크 테스트(.github/workflows/ci.yml)가 쓰는 값과 같은 형태다.
# 로컬 개발 전용 더미 토큰이니, 실제 배포 전 반드시 새 값으로 교체하라.
MCP_CLIENT_TOKENS='{"dev-local-token-change-me":{"client_id":"local-dev","role":"reader","scopes":["devoks:read"]}}'

# CTR-007 역할↔툴 매핑. JSON: {role: [tool_name, ...]}. Stage 1은 4개 코어 GitHub
# 툴이 전부 읽기 전용이라 단일 역할(reader)로 시작한다. 위 MCP_CLIENT_TOKENS가
# 참조하는 role은 반드시 이 맵의 키로 존재해야 한다(둘 다 필수 키이고, 서로 참조를
# 검증한다).
MCP_ROLE_TOOLS='{"reader":["list_repos","get_repo_tree","read_file","search_code"]}'

# GitHub App의 client ID 또는 App ID(App JWT의 `iss` 클레임). GitHub은 둘 다
# 받고 client ID를 권장하지만, 서버는 이 값을 그대로 통과시키므로 어느 쪽을
# 넣어도 동작한다.
GITHUB_APP_ID='123456'

# ⚠️ 절대 실제 프라이빗 키를 이 파일(혹은 .env)에 커밋하지 마라. 아래 값은 형식만
# 보여주는 플레이스홀더이며 실제 PEM이 아니다 — 그대로 두면 config.py의 PEM 파싱
# 검증(cryptography.load_pem_private_key)에서 기동 실패한다.
#
# 로컬 개발/CI 스모크 테스트용 임시 RSA 키가 필요하면(GitHub에 실제로 등록하지
# 않아도 서버는 기동한다 — 아래 GITHUB_APP_INSTALLATION_ID 설명 참고):
#   openssl genrsa -out /tmp/dev-github-app-key.pem 2048
#   python3 -c "print(open('/tmp/dev-github-app-key.pem').read().replace(chr(10), '\\n'))"
# 두 번째 명령의 출력(개행이 리터럴 "\n"으로 치환된 한 줄)을 아래 값 자리에
# 작은따옴표로 감싸 넣어라. config.py가 "\n" -> 실제 개행으로 정규화하므로 한 줄
# 형태로 넣어도 정상 파싱된다.
GITHUB_APP_PRIVATE_KEY='-----BEGIN RSA PRIVATE KEY-----\nMIIExamplePlaceholderDoNotUseThisKey...\n-----END RSA PRIVATE KEY-----\n'

# GitHub App의 조직 설치(installation) ID. 실제 GitHub App 등록·설치는 조직
# 관리자 권한이 필요하다(FRD §6.4 RES-API-005). 등록 전에도 위 두 키에 형식만
# 맞는 값을 넣어 두면 서버는 기동하고 /healthz도 정상 응답한다 — GitHub App
# installation 토큰 발급은 지연 평가라(app.py 참고) 실제로 GitHub 조회 툴을
# 호출하기 전까지는 GitHub를 향한 호출이 전혀 일어나지 않는다. 4개 GitHub 툴을
# 실제로 쓰려면 이 값도 실제 installation ID로 교체해야 한다.
GITHUB_APP_INSTALLATION_ID='12345678'

# ============================================================================
# 선택 — 미설정 시 기본값 사용 (범위를 벗어나면 그때는 기동 실패)
# ============================================================================

# CTR-008 저장소 allowlist. 콤마 구분 'owner/repo' 완전일치, 와일드카드 없음.
# ⚠️ 위 필수 키들과 정반대 방향이다 — 이 키는 "없어도 기동은 성공"하지만
# "빈 값(기본값) = 모든 저장소 접근 거부"(fail-safe)다. 실제로 list_repos 등
# GitHub 조회 툴에서 결과를 받으려면 반드시 채워야 한다.
MCP_REPO_ALLOWLIST='your-org/your-repo'

# 리스닝 포트. 기본값 8000.
MCP_PORT='8000'

# 서버 로그 레벨(DEBUG/INFO/WARNING/ERROR/CRITICAL). 기본값 INFO.
# ⚠️ stdout에 JSON Lines 1줄/호출로 남는 감사 로그(CTR-003)와는 완전히 별개다 —
# 이 레벨을 올리거나 내려도 감사 레코드는 필터링되지 않고 항상 전량 남는다.
MCP_LOG_LEVEL='INFO'

# CTR-004 — read_file 응답 상한(bytes, 1..1048576). 기본값 262144(256 KiB).
# 상한을 넘는 파일은 이 크기까지 절단되어 반환되고, 절단됐다는 사실과 전체 크기가
# 함께 전달된다.
MCP_READ_FILE_MAX_BYTES='262144'

# CTR-005 — search_code 최대 결과 수(1..100). 기본값 30.
# GitHub 코드 검색 자체가 인증 상태에서도 "분당 10회"로 제한된다(다른 GitHub 검색
# 엔드포인트의 분당 30회보다 훨씬 빡빡한 별도 버킷) — 이 값을 올려도 그 호출 빈도
# 제약은 그대로다.
MCP_SEARCH_CODE_MAX_RESULTS='30'

# CTR-009 — GitHub App installation 토큰 갱신 여유(seconds, 60..1800). 기본값 300.
# 캐시된 토큰의 잔여 수명이 이 값 이하로 떨어지면, 다음 GitHub 호출 전에 자동으로
# 재발급한다.
MCP_TOKEN_REFRESH_LEEWAY_SECONDS='300'

# CTR-011 — Streamable HTTP 프로토콜 모드. 허용 값: true/false, 1/0, yes/no, on/off
# (대소문자 무관). 오타는 조용히 넘어가지 않고 기동 실패한다 — Python의 bool("false")
# 가 True인 탓에 관대한 파서는 오타를 정반대 모드로 바꿔버리기 때문이다.
#
# 두 값은 실측상 완전히 독립이다:
#   MCP_STATELESS_HTTP → `Mcp-Session-Id` 발급 여부
#   MCP_JSON_RESPONSE  → 응답 미디어타입 (application/json vs text/event-stream)
#
# 기본값은 둘 다 true이며, 이는 배포 타깃이 AWS Lambda + Function URL이기 때문이다.
# Lambda 실행 환경은 호출 사이에 동결되고 예고 없이 교체되므로, 세션 ID를 발급하면
# 이후 호출이 그 세션을 들고 있다고 보장할 수 없고, 응답보다 오래 사는 SSE 스트림은
# 동결과 충돌한다. 로컬 개발에서도 기본값 그대로 쓰면 된다.
#
# 둘 다 false로 두면 sticky session을 지원하는 로드밸런서 뒤에서 동작하는 모드가
# 된다(FRD §7 선택지 (a)) — 서버→클라이언트 역채널(sampling, elicitation)과 재개
# 가능성을 되찾는 대신 세션 친화 라우팅이 필수가 된다. Stage 1의 4개 툴은 모두 단발
# 조회라 역채널을 쓰지 않는다.
MCP_STATELESS_HTTP='true'
MCP_JSON_RESPONSE='true'
